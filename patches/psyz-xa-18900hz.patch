 } xa;
@@ -594,10 +596,10 @@ static int xa_read_and_decode_sector(void) {
         int stereo = (ci & 0x03) == 1;
         int rate18900 = (ci & 0x04) != 0;
         int bits8 = (ci & 0x30) != 0;
-        if (rate18900 || bits8) {
-            LOG_ONCE(
-                "XA: 18900Hz or 8-bit not supported, decoding as 4bit/37800");
+        if (bits8) {
+            LOG_ONCE("XA: 8-bit not supported, decoding as 4bit");
         }
+        xa.step = rate18900 ? XA_STEP_Q16_18900 : XA_STEP_Q16;
         if (stereo) {
             xa.decoded_count = xa_decode_user_stereo_4bit(user);
         } else {
@@ -687,7 +689,7 @@ static size_t xa_pull_samples(short* buf, size_t max_frames) {
